# Optional: without these the app runs the explicitly labelled simulated demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Optional comma-separated model IDs for npm run evals -- --live
EVAL_MODELS=
# Supabase public project credentials only. Never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Live planning requires Supabase guest auth in production; enable anonymous sign-in.
# For private localhost development without Supabase only:
ALLOW_LOCAL_LIVE=false
