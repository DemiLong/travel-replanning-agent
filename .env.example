# Required for AI semantic parsing. The key is server-only; never prefix it with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AMAP_API_KEY=
# Optional comma-separated model IDs for npm run evals -- --live
EVAL_MODELS=
# Supabase public project credentials only. Never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Retained legacy setting; the real anonymous browser flow does not depend on Supabase.
ALLOW_LOCAL_LIVE=false
