# Required for AI semantic parsing. The key is server-only; never prefix it with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AMAP_API_KEY=
# Optional comma-separated model IDs for npm run evals -- --live
EVAL_MODELS=
# Required in production for silent anonymous API authentication and rate limits.
# Enable Anonymous Sign-Ins and apply supabase/migrations before deployment.
# These are public project credentials; never expose a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Development-only bypass. It is ignored in production and for non-loopback hosts.
ALLOW_LOCAL_LIVE=false
