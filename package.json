{
  "name": "dynamic-travel-replanning-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-playwright --ignore-pattern playwright-report --ignore-pattern test-results",
    "db:generate": "drizzle-kit generate",
    "dev:next": "next dev --port 3000",
    "build:vercel": "next build --webpack",
    "start:next": "next start --port 3000",
    "dev:sites": "vinext dev --port 5173",
    "build:sites": "vinext build",
    "start:sites": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "typecheck": "tsc --noEmit",
    "evals": "node --env-file-if-exists=.env.local scripts/run-evals.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/run-evals.mjs --test",
    "test:e2e": "node scripts/run-isolated-playwright.mjs",
    "test:p0-live": "npm run build && node scripts/run-playwright.mjs -c playwright.live.config.ts",
    "test:semantic-live": "node --env-file-if-exists=.env.local scripts/test-live.mjs --semantic-only",
    "test:world-live": "node --env-file-if-exists=.env.local scripts/test-live.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "openai": "^7.13.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tsx": "^4.23.13",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
